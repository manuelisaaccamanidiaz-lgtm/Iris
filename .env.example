# Plantilla de variables de entorno de Iris.
# Copia este archivo como .env (que Git ignora) y cambia los valores.
# NUNCA subas el .env real al repositorio.

# --- Base de datos (Docker y Spring Boot leen las mismas) ---
POSTGRES_DB=iris
POSTGRES_USER=iris
POSTGRES_PASSWORD=cambia_esta_clave
# 5433 para no chocar con un PostgreSQL que ya tengas en el 5432
DB_PORT=5433

# --- Seguridad ---
# Clave para firmar los JWT: mínimo 32 caracteres aleatorios. Genera una en PowerShell con:
#   [Convert]::ToBase64String((1..48 | ForEach-Object { Get-Random -Maximum 256 }))
JWT_SECRET=cambia_esto_por_una_clave_larga_y_aleatoria

# Frontends permitidos por CORS (opcional; por defecto https://localhost:5173)
# CORS_ORIGENES=https://localhost:5173

# --- HTTPS ---
# Certificado de desarrollo hecho con mkcert (ver README). Rutas ABSOLUTAS, con "file:" y barras /
TLS_CERTIFICADO=file:C:/ruta/a/proyecto-iris/certs/localhost.pem
TLS_LLAVE=file:C:/ruta/a/proyecto-iris/certs/localhost-key.pem

# --- Administrador inicial (se crea al arrancar si no existe; opcional) ---
IRIS_ADMIN_NOMBRE=Administrador
IRIS_ADMIN_EMAIL=admin@iris.com
IRIS_ADMIN_PASSWORD=cambia_esta_clave_admin

# --- IA ---
# Clave de Google AI Studio (https://aistudio.google.com) para los embeddings de Gemini
GEMINI_API_KEY=pon_tu_clave_aqui

# Clave de Groq (https://console.groq.com/keys) para redactar las respuestas
GROQ_API_KEY=pon_tu_clave_aqui
# Opcional: otro modelo de Groq (por defecto openai/gpt-oss-120b).
# Para ver los que tiene tu cuenta: GET https://api.groq.com/openai/v1/models
# GROQ_MODELO=openai/gpt-oss-20b

# --- Antivirus (ClamAV) ---
# Encendido por defecto: arranca con "docker compose up -d" y pide de 3 a 4 GiB de RAM.
# Encendido y caído = los PDF se rechazan (503), por seguridad. Para apagarlo en un equipo con poca RAM:
# ANTIVIRUS_HABILITADO=false

# --- Correo (Día 4.3) ---
# Apagado por defecto. Con "docker compose up -d" también arranca Mailpit:
# los correos se ven en http://localhost:8025 (no salen a Internet)
CORREO_HABILITADO=true
# Para Gmail (cuando haya cuenta), descomenta y completa. La contraseña es la "de aplicación":
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_SMTP_AUTH=true
# MAIL_STARTTLS=true
# MAIL_USUARIO=tu_cuenta@gmail.com
# MAIL_PASSWORD=pon_tu_contraseña_de_aplicacion
# CORREO_REMITENTE=Iris <tu_cuenta@gmail.com>
