# Plantilla de variables de entorno de Iris.
# Copia este archivo como .env (que Git ignora) y cambia los valores.
# NUNCA subas el .env real al repositorio.

# --- Base de datos (Docker y Spring Boot leen las mismas) ---
POSTGRES_DB=iris
POSTGRES_USER=iris
POSTGRES_PASSWORD=cambia_esta_clave
# 5433 para no chocar con un PostgreSQL que ya tengas en el 5432
DB_PORT=5433

# --- Seguridad ---
# Clave para firmar los JWT: mínimo 32 caracteres aleatorios. Genera una en PowerShell con:
#   [Convert]::ToBase64String((1..48 | ForEach-Object { Get-Random -Maximum 256 }))
JWT_SECRET=cambia_esto_por_una_clave_larga_y_aleatoria

# --- Se usarán en los próximos pasos ---
# GEMINI_API_KEY=
# GROQ_API_KEY=
